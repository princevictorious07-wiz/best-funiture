    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button class="modal-close" id="closeModalBtn" aria-label="Close modal">&times;</button>
      <h3 id="modalTitle">Order or Request Price</h3>
      <p id="modalSubtitle" style="font-size: 0.9rem; color: var(--ink-muted); margin: 0.35rem 0 1rem;">
        Tell us what item caught your eye and reach us right away.
      </p>

      <form id="modalForm">
        <div class="form-group">
          <label for="modalItem">Selected Item</label>
          <input type="text" id="modalItem" required />
        </div>
        <div class="form-group">
          <label for="modalName">Your Name</label>
          <input type="text" id="modalName" placeholder="Your full name" required />
        </div>
        <div class="form-group">
          <label for="modalNotes">Notes (Color, Quantity, or Delivery in Wukari)</label>
          <textarea id="modalNotes" rows="3" placeholder="e.g., Need 1 set in brown/cream..."></textarea>
        </div>
        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-whatsapp" id="modalWhatsappBtn" style="flex: 1;">WhatsApp Inquiry</button>
          <button type="submit" class="btn btn-primary" style="flex: 1;">Email Inquiry</button>
        </div>
      </form>
    </div>
  </div>

  <!-- JAVASCRIPT -->
  <script>
    const BUSINESS = {
      name: "Prince Victoria's Best Furnitures",
      email: "princevictorious07@gmail.com",
      displayPhone: "080-677-11844",
      whatsappNumber: "2348067711844",
      address: "Along Katsina-Ala Road, Opposite Federal University, Wukari LGA, Exit Gate, Taraba State"
    };

    const FURNITURE_ITEMS = [
      {
        id: 1,
        name: "Royal Fabric Sofa Set",
        category: "Living Room",
        icon: "🛋️",
        priceLabel: "Ask for Price",
        description: "Plush cushions with a sturdy hardwood frame suited for family living rooms and guest lounges."
      },
      {
        id: 2,
        name: "Modern TV Console & Cabinet",
        category: "Living Room",
        icon: "📺",
        priceLabel: "Ask for Price",
        description: "Clean storage compartments for decoders, media boxes, and living room decor."
      },
      {
        id: 3,
        name: "Solid Wood Double & King Beds",
        category: "Bedroom",
        icon: "🛏️",
        priceLabel: "Ask for Price",
        description: "Stable, creak-free bed frames crafted for comfortable rest and long-term durability."
      },
      {
        id: 4,
        name: "Sliding & Hinged Wardrobes",
        category: "Bedroom",
        icon: "🚪",
        priceLabel: "Ask for Price",
        description: "Spacious hanging rails and shelves to keep clothes and personal items organized."
      },
      {
        id: 5,
        name: "Family Dining Table & Chairs",
        category: "Dining",
        icon: "🍽️",
        priceLabel: "Ask for Price",
        description: "Smooth-finished dining tables paired with comfortable chairs for shared meals."
      },
      {
        id: 6,
        name: "Executive Desk & Study Table",
        category: "Office & Study",
        icon: "💼",
        priceLabel: "Ask for Price",
        description: "Practical work surfaces with drawers for offices, lecturers, and students near FUW."
      }
    ];

    const catalogGrid = document.getElementById("catalogGrid");
    const filterBar = document.getElementById("filterBar");
    const menuToggle = document.getElementById("menuToggle");
    const navMenu = document.getElementById("navMenu");
    const inquiryModal = document.getElementById("inquiryModal");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const openInquiryBtn = document.getElementById("openInquiryBtn");
    const cardQuoteBtn = document.getElementById("cardQuoteBtn");
    const modalItemInput = document.getElementById("modalItem");
    const modalNameInput = document.getElementById("modalName");
    const modalNotesInput = document.getElementById("modalNotes");
    const modalForm = document.getElementById("modalForm");
    const modalWhatsappBtn = document.getElementById("modalWhatsappBtn");
    const contactForm = document.getElementById("contactForm");
    const formWhatsappBtn = document.getElementById("formWhatsappBtn");
    const formStatus = document.getElementById("formStatus");
    const heroWhatsappLink = document.getElementById("heroWhatsappLink");

    function buildWhatsAppUrl(messageText) {
      return `https://wa.me/${BUSINESS.whatsappNumber}?text=${encodeURIComponent(messageText)}`;
    }

    function buildMailtoUrl(subject, body) {
      return `mailto:${BUSINESS.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }

    // Set hero WhatsApp link
    heroWhatsappLink.href = buildWhatsAppUrl(
      `Hello ${BUSINESS.name}, I would like to inquire about furniture available in Wukari.`
    );

    // Render furniture cards
    function renderCatalog(category = "All") {
      const filtered = category === "All"
        ? FURNITURE_ITEMS
        : FURNITURE_ITEMS.filter(item => item.category === category);

      catalogGrid.innerHTML = filtered.map(item => `
        <article class="product-card">
          <div>
            <div class="product-banner" aria-hidden="true">${item.icon}</div>
            <div class="product-body">
              <span class="product-cat">${item.category}</span>
              <h3 class="product-title">${item.name}</h3>
              <p class="product-desc">${item.description}</p>
              <div class="product-meta">
                <span class="price">${item.priceLabel}</span>
                <button class="btn btn-primary btn-sm inquire-item-btn" data-item="${item.name}">
                  Order / Inquire
                </button>
              </div>
            </div>
          </div>
        </article>
      `).join("");

      document.querySelectorAll(".inquire-item-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          openModal(btn.dataset.item);
        });
      });
    }

    // Category filter click
    filterBar.addEventListener("click", (e) => {
      const btn = e.target.closest(".filter-btn");
      if (!btn) return;

      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderCatalog(btn.dataset.category);
    });

    // Mobile nav toggle
    menuToggle.addEventListener("click", () => {
      navMenu.classList.toggle("open");
    });

    navMenu.querySelectorAll("a, button").forEach(el => {
      el.addEventListener("click", () => navMenu.classList.remove("open"));
    });

    // Modal controls
    function openModal(itemName = "Custom Furniture / Price Quote") {
      modalItemInput.value = itemName;
      inquiryModal.classList.add("open");
      inquiryModal.setAttribute("aria-hidden", "false");
      modalNameInput.focus();
    }

    function closeModal() {
      inquiryModal.classList.remove("open");
      inquiryModal.setAttribute("aria-hidden", "true");
    }

    openInquiryBtn.addEventListener("click", () => openModal());
    cardQuoteBtn.addEventListener("click", () => openModal("Price Quote Request"));
    closeModalBtn.addEventListener("click", closeModal);

    inquiryModal.addEventListener("click", (e) => {
      if (e.target === inquiryModal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && inquiryModal.classList.contains("open")) {
        closeModal();
      }
    });

    // Modal actions
    modalForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const item = modalItemInput.value.trim();
      const name = modalNameInput.value.trim();
      const notes = modalNotesInput.value.trim();

      const body = [
        `Hello ${BUSINESS.name},`,
        ``,
        `My name is ${name}. I would like to inquire about: ${item}.`,
        notes ? `Notes: ${notes}` : "",
        ``,
        `Location reference: ${BUSINESS.address}`
      ].filter(Boolean).join("\n");

      window.location.href = buildMailtoUrl(`Furniture Inquiry: ${item}`, body);
    });

    modalWhatsappBtn.addEventListener("click", () => {
      const item = modalItemInput.value.trim() || "Furniture";
      const name = modalNameInput.value.trim() || "a customer";
      const notes = modalNotesInput.value.trim();

      const msg = [
        `Hello ${BUSINESS.name}, I'm ${name}.`,
        `I'm interested in: ${item}.`,
        notes ? `Details: ${notes}` : ""
      ].filter(Boolean).join(" ");

      window.open(buildWhatsAppUrl(msg), "_blank", "noopener");
    });

    // Main contact form actions
    contactForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = document.getElementById("customerName").value.trim();
      const phone = document.getElementById("customerPhone").value.trim();
      const interest = document.getElementById("furnitureInterest").value;
      const message = document.getElementById("customerMessage").value.trim();

      const body = [
        `Name: ${name}`,
        `Phone/WhatsApp: ${phone}`,
        `Interest: ${interest}`,
        `Message: ${message || "Please share available options and prices."}`
      ].join("\n");

      formStatus.textContent = "Opening your email app with your inquiry...";
      window.location.href = buildMailtoUrl(`Website Inquiry - ${interest}`, body);
    });

    formWhatsappBtn.addEventListener("click", () => {
      const name = document.getElementById("customerName").value.trim() || "Customer";
      const phone = document.getElementById("customerPhone").value.trim();
      const interest = document.getElementById("furnitureInterest").value;
      const message = document.getElementById("customerMessage").value.trim();

      const msg = [
        `Hello ${BUSINESS.name}, my name is ${name}.`,
        phone ? `Phone: ${phone}.` : "",
        `I'm looking for: ${interest}.`,
        message ? `Note: ${message}` : ""
      ].filter(Boolean).join(" ");

      formStatus.textContent = "Opening WhatsApp chat...";
      window.open(buildWhatsAppUrl(msg), "_blank", "noopener");
    });

    // Footer year & initial render
    document.getElementById("year").textContent = new Date().getFullYear();
    renderCatalog("All");
  </script>
</body>
</html>